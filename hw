#include <WiFi.h>       // สำหรับ ESP32/ESP8266 (หากใช้ Arduino UNO ให้ปรับไลบรารีตามบอร์ด)
#include "secrets.h"    // ดึงค่า SECRET_SSID และ SECRET_PASS มาใช้

const char* ssid = SECRET_SSID;
const char* password = SECRET_PASS;

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("Ngooooo");
  Serial.print("SSID: ");
  Serial.println(ssid);
  Serial.print("Password: ");
  Serial.println(password);

  WiFi.begin(ssid, password);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nเชื่อมต่อ Wi-Fi สำเร็จ!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nเชื่อมต่อไม่สำเร็จ กรุณาตรวจสอบ SSID/Password ใน secrets.h");
  }
}

void loop() {
  // ใส่โค้ดการทำงานหลักตรงนี้
  delay(1000);
}